{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "ui-acceptance/v1",
  "required": [
    "schema",
    "illustrative_only",
    "id",
    "revision",
    "fixture_version",
    "integration_mode",
    "route",
    "viewports",
    "states",
    "checks",
    "policy",
    "change_policy",
    "limitations",
    "capture_inventory"
  ],
  "properties": {
    "schema": {
      "const": "ui-acceptance/v1"
    },
    "illustrative_only": {
      "const": false
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "fixture_version": {
      "type": "string",
      "minLength": 1
    },
    "integration_mode": {
      "const": "prototype_mock"
    },
    "route": {
      "type": "string",
      "minLength": 1
    },
    "viewports": {
      "type": "array",
      "minItems": 1
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "required", "method", "outcome"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "const": true
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["not_applicable"]
    },
    "change_policy": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capture_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state", "width"],
        "properties": {
          "state": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
