{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "ui-acceptance/v1",
  "required": [
    "schema",
    "illustrative_only",
    "id",
    "revision",
    "fixture_version",
    "integration_mode",
    "route",
    "viewports",
    "states",
    "checks",
    "policy",
    "change_policy",
    "limitations",
    "capture_inventory",
    "additional_widths"
  ],
  "properties": {
    "schema": {
      "const": "ui-acceptance/v1"
    },
    "illustrative_only": {
      "const": false
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "fixture_version": {
      "type": "string",
      "minLength": 1
    },
    "integration_mode": {
      "const": "prototype_mock"
    },
    "route": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["width", "height"],
        "properties": {
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "required", "method", "outcome"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "const": true
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "contains": {
        "type": "object",
        "required": ["method", "required"],
        "properties": {
          "method": {
            "const": "independent_actual_image_review"
          },
          "required": {
            "const": true
          }
        }
      },
      "minContains": 1
    },
    "policy": {
      "type": "object",
      "required": ["not_applicable"],
      "properties": {
        "not_applicable": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["condition", "rationale"],
            "properties": {
              "condition": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "change_policy": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capture_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["state", "width"],
        "properties": {
          "state": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "uniqueItems": true,
      "description": "Capture state names must be globally unique; executable validation enforces uniqueness before state-name equivalence lookup."
    },
    "capture_equivalence_groups": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "additional_widths": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
