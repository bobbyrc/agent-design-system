{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "ui-run/v1",
  "title": "Builder-writable runtime evidence",
  "required": [
    "schema",
    "illustrative_only",
    "source_hash",
    "contract_hash",
    "fixture_hash",
    "run_id",
    "acceptance_contract_id",
    "fixture_version",
    "integration_mode",
    "execution_started_at",
    "execution_finished_at",
    "environment",
    "provenance",
    "checks",
    "artifacts",
    "review",
    "result",
    "artifact"
  ],
  "properties": {
    "schema": {
      "const": "ui-run/v1"
    },
    "illustrative_only": {
      "const": false
    },
    "source_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "contract_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixture_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "acceptance_contract_id": {
      "type": "string",
      "minLength": 1
    },
    "fixture_version": {
      "type": "string",
      "minLength": 1
    },
    "integration_mode": {
      "const": "prototype_mock"
    },
    "execution_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution_finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "object",
      "required": ["host", "host_version", "browser_version", "tool_versions"],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "host_version": {
          "type": "string",
          "minLength": 1
        },
        "browser_version": {
          "type": "string",
          "minLength": 1
        },
        "tool_versions": {
          "type": "object"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["protected_evaluator", "served_build_identity"],
      "properties": {
        "protected_evaluator": {
          "const": false
        },
        "served_build_identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "result", "reason", "executed", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]
          },
          "reason": {
            "type": "string"
          },
          "executed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "kind",
          "source_hash",
          "contract_hash",
          "fixture_hash",
          "run_id"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "contract_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fixture_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "image"
                }
              },
              "required": ["kind"]
            },
            "then": {
              "required": ["state", "width"],
              "properties": {
                "state": {
                  "type": "string",
                  "minLength": 1
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        ]
      }
    },
    "review": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "result": {
      "enum": ["PASS", "FAIL", "BLOCKED"]
    },
    "artifact": {
      "type": "object",
      "required": ["commit", "working_tree_or_build_hash"],
      "properties": {
        "commit": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{40}$"
        },
        "working_tree_or_build_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_files": {
          "type": "array"
        }
      }
    }
  }
}
