  "checks": [
    {
      "id": "TASK-RETURN-01",
      "required": true,
      "method": "interaction_and_store_assertion",
      "outcome": "Filter overdue loans by Mina, open kit-12, check recorder/microphone/cables, submit; expected kit status returned, one kit-12 returned event, six overdue becomes five, UI success agrees with teaching store."
    },
    {
      "id": "RETURN-FAIL-01",
      "required": true,
      "method": "failure_fixture_and_store_assertion",
      "outcome": "First failed save retains all three checks and actionable retry; fixture loans/events unchanged until retry records exactly one return."
    },
    {
      "id": "DUPLICATE-01",
      "required": true,
      "method": "repeated_activation_and_store_assertion",
      "outcome": "Repeated activation during 650ms pending lock records exactly one kit-12 return event."
    },
    {
      "id": "NARROW-01",
      "required": true,
      "method": "geometry_and_image_inspection",
      "outcome": "No whole-page overflow or clipped interactive controls at 320/390/768/1440 and 599/600/601/899/900/901px; identity/due/action usable; narrow UI and browser Back preserve query/scope/returns and restore selected row or Search focus; breakpoint changes restore a visible view and focus; long content plus 200% enlarged/spaced text at 320 and 390 included."
    },
    {
      "id": "KEYBOARD-01",
      "required": true,
      "method": "keyboard_task_inspection",
      "outcome": "Complete return with actual Tab, Space and Enter events without pointer, visible focus at every critical step and focus can leave task."
    },
    {
      "id": "A11Y-AUTO-01",
      "required": true,
      "method": "state_specific_accessibility_scan_and_triage",
      "outcome": "Scan queue/detail/pending/success/failure/empty/loading/long-content at 390/768/1440 plus no-matches and missing-accessory at 1440; capture loading-ready at 390/768/1440; every finding explicitly handled and unresolved findings fail. Load-error locking is independently exercised by actual-browser regression."
    },
    {
      "id": "VISUAL-01",
      "required": true,
      "method": "independent_actual_image_review",
      "outcome": "Fresh independent inspection covers exact current captured images and task evidence; no unresolved blocker/major, minor findings accepted explicitly with rationale."
    }
  ],
  "policy": {
    "not_applicable": {},
    "minor_findings": "explicit_acceptance_with_rationale",
    "accessibility_findings": "every_violation_requires_explicit_disposition; serious/critical unresolved fail",
    "visual_rubric": [
      "Hierarchy",
      "Typography/readability",
      "Composition/density",
      "Component grammar",
      "Content clarity",
      "State coherence"
    ]
  },
  "change_policy": "Version and explain legitimate changes; never remove requirements or rebaseline merely to pass.",
  "limitations": [
